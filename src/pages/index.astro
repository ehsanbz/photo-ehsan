---
import SiteLayout from '../layouts/SiteLayout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { getPublishedAlbums, type Photo } from '../lib/flickr';
const albums = (await getPublishedAlbums()).sort((a, b) => Number(b.featured) - Number(a.featured));
const collected = new Map<string, { photo: Photo; albums: string[] }>();
for (const album of albums) {
  for (const photo of album.photos.slice(0, 48)) {
    const existing = collected.get(photo.id);
    if (existing) existing.albums.push(album.slug);
    else collected.set(photo.id, { photo, albums: [album.slug] });
  }
}
const photos = [...collected.values()];
---
<SiteLayout title="Photography" description="Photography by Ehsan Bagherzadeh. Berlin, architecture, streets and journeys." image={photos[0]?.photo.full} noindex={!photos.length}>
  <div class="page-width">
    <div class="home-heading"><h1>Photographs, places, passing moments.</h1><p>Berlin & elsewhere</p></div>
    {photos.length > 0 ? <>
      <nav class="album-filters" aria-label="Filter photographs by album">
        <button type="button" data-filter="all" aria-pressed="true">All photographs</button>
        {albums.filter(album => album.photos.length).map(album => <button type="button" data-filter={album.slug} aria-pressed="false">{album.title}</button>)}
      </nav>
      <PhotoGrid items={photos} heading="Selected photographs" />
      <div class="after-grid"><a href="/albums/">Explore all albums <span aria-hidden="true">↗</span></a></div>
    </> : <div class="empty-state"><p>Photography will appear here soon.</p><a href="/about/">About the photographer ↗</a></div>}
  </div>
</SiteLayout>
