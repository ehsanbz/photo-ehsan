---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PhotoFigure from '../../components/PhotoFigure.astro';
import { formatDate } from '../../lib/content';
export async function getStaticPaths() {
  return (await getCollection('stories', ({ data }) => !data.draft)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const coverPhoto = entry.data.photos[0]?.image.src === entry.data.cover.src ? entry.data.photos[0] : undefined;
const bodyPhotos = coverPhoto ? entry.data.photos.slice(1) : entry.data.photos;
const coverWidths = [...new Set([480, 768, 1200, 1600, 2200, entry.data.cover.width].filter((width) => width <= entry.data.cover.width))].sort((a, b) => a - b);
---
<SiteLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} type="article" noindex={entry.data.sample}>
  <article>
    <header class="article-head wrap"><span class="eyebrow">Photo essay {entry.data.sample && '· Sample story'}</span><h1>{entry.data.title}</h1>{entry.data.subtitle && <p class="subtitle">{entry.data.subtitle}</p>}<div class="article-meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>{entry.data.location && <span>{entry.data.location}</span>}{entry.data.tags.length > 0 && <span>{entry.data.tags.join(' / ')}</span>}</div></header>
    <figure class="article-hero"><Image src={entry.data.cover} alt={entry.data.coverAlt} widths={coverWidths} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />{coverPhoto?.caption && <figcaption class="wrap image-caption">{coverPhoto.caption}</figcaption>}</figure>
    <div class="article-body"><Content /></div>
    {coverPhoto?.textAfter && <p class="between-photos">{coverPhoto.textAfter}</p>}
    {bodyPhotos.map((photo, index) => <PhotoFigure photo={photo} size={index % 3 === 0 ? 'wide' : 'regular'} />)}
    <div class="wrap back-link"><a class="text-link" href="/stories/">← All stories</a>{entry.data.sample && <p class="sample-note">Sample imagery and text demonstrate the layout. Replace these with your own photographs before sharing this as your portfolio.</p>}</div>
  </article>
</SiteLayout>
