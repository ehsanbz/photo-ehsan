---
import type { Photo } from '../lib/flickr';
interface Item { photo: Photo; albums?: string[]; }
interface Section { afterPhotoId: string; text: string; }
interface Props { items: Item[]; heading?: string; sections?: Section[]; }
const { items, heading = 'Photographs', sections = [] } = Astro.props;
---
<section class="photo-grid" data-gallery aria-label={heading}>
  {items.map(({ photo, albums = [] }, index) => (<>
    <figure class="photo-item" id={`photo-${photo.id}`} data-albums={albums.join(' ')}>
      <a class="photo-open" href={photo.full} data-photo-link
        data-title={photo.title || 'Photograph'}
        data-description={photo.description}
        data-date={photo.date || ''}
        data-exif={photo.exif || ''}
        data-full={photo.full}
        data-flickr={photo.flickrUrl}
        aria-label={`View ${photo.title || 'photograph'} larger`}>
        <img src={photo.src} srcset={photo.srcset} sizes="(max-width: 520px) 50vw, (max-width: 840px) 50vw, (max-width: 1199px) 33vw, 25vw"
          width={photo.width} height={photo.height} alt={photo.title || photo.description || 'Photograph by Ehsan Bagherzadeh'}
          loading={index < 4 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" />
        <span class="image-unavailable" hidden>Image unavailable · View on Flickr ↗</span>
        <span class="photo-overlay" aria-hidden="true">{photo.title || 'View photograph'} <span>↗</span></span>
      </a>
      {photo.title && <figcaption>{photo.title}</figcaption>}
    </figure>
    {sections.filter(section => section.afterPhotoId === photo.id).map(section => <div class="grid-text">{section.text}</div>)}
  </>))}
</section>
{items.length > 0 && <dialog class="lightbox" data-lightbox aria-label="Photograph viewer">
  <div class="viewer">
    <div class="viewer-top"><span>Ehsan Bagherzadeh / Photography</span><button type="button" data-close aria-label="Close viewer">Close <span aria-hidden="true">×</span></button></div>
    <div class="viewer-stage">
      <button type="button" data-prev aria-label="Previous photograph">←</button>
      <img data-viewer-image alt="" />
      <p data-viewer-error hidden>Image unavailable. Try viewing it on Flickr.</p>
      <button type="button" data-next aria-label="Next photograph">→</button>
    </div>
    <div class="viewer-bottom">
      <div class="viewer-caption"><strong data-title></strong><span data-description></span><span data-date></span><details data-exif-wrap><summary>Technical details</summary><span data-exif></span></details></div>
      <div class="viewer-actions"><span data-counter aria-live="polite"></span><a data-flickr href="https://www.flickr.com/" target="_blank" rel="noopener noreferrer">On Flickr ↗</a></div>
    </div>
  </div>
</dialog>}
<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const viewer = dialog?.querySelector<HTMLImageElement>('[data-viewer-image]');
  let current = 0;
  let opener: HTMLAnchorElement | null = null;
  const viewerError = dialog?.querySelector<HTMLElement>('[data-viewer-error]');
  gallery?.querySelectorAll<HTMLImageElement>('.photo-item img').forEach(img => img.addEventListener('error', () => {
    const link = img.closest<HTMLAnchorElement>('.photo-open');
    if (!link) return;
    img.hidden = true;
    link.querySelector<HTMLElement>('.image-unavailable')?.removeAttribute('hidden');
    link.href = link.dataset.flickr || 'https://www.flickr.com/';
    link.removeAttribute('data-photo-link');
    link.setAttribute('aria-label', 'Image unavailable; view photograph on Flickr');
  }));
  viewer?.addEventListener('error', () => { if (viewer) viewer.hidden = true; if (viewerError) viewerError.hidden = false; });
  const links = () => [...(gallery?.querySelectorAll<HTMLAnchorElement>('.photo-item:not([hidden]) [data-photo-link]') ?? [])];
  const set = (selector: string, value: string) => {
    const element = dialog?.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };
  function display(index: number) {
    const available = links();
    if (!available.length || !viewer || !dialog) return;
    current = (index + available.length) % available.length;
    const link = available[current];
    viewer.hidden = false;
    if (viewerError) viewerError.hidden = true;
    viewer.src = link.dataset.full || link.href;
    viewer.alt = link.querySelector('img')?.alt || '';
    set('[data-title]', link.dataset.title || '');
    set('[data-description]', link.dataset.description || '');
    set('[data-date]', link.dataset.date?.slice(0, 10) || '');
    set('[data-exif]', link.dataset.exif || '');
    set('[data-counter]', `${current + 1} / ${available.length}`);
    const details = dialog.querySelector<HTMLElement>('[data-exif-wrap]');
    if (details) details.hidden = !link.dataset.exif;
    const flickr = dialog.querySelector<HTMLAnchorElement>('[data-flickr]');
    if (flickr) flickr.href = link.dataset.flickr || 'https://www.flickr.com/';
  }
  gallery?.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-photo-link]');
    if (!link || !dialog) return;
    event.preventDefault();
    opener = link;
    display(links().indexOf(link));
    dialog.showModal();
    dialog.querySelector<HTMLButtonElement>('[data-close]')?.focus();
  });
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-prev]')?.addEventListener('click', () => display(current - 1));
  dialog?.querySelector('[data-next]')?.addEventListener('click', () => display(current + 1));
  dialog?.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      display(current + (event.key === 'ArrowRight' ? 1 : -1));
    }
  });
  dialog?.addEventListener('close', () => { viewer?.removeAttribute('src'); opener?.focus(); });
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  let startX = 0;
  dialog?.addEventListener('touchstart', event => { startX = event.changedTouches[0].screenX; }, { passive: true });
  dialog?.addEventListener('touchend', event => {
    const delta = event.changedTouches[0].screenX - startX;
    if (Math.abs(delta) > 65) display(current + (delta < 0 ? 1 : -1));
  }, { passive: true });
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(tab => tab.setAttribute('aria-pressed', String(tab === button)));
    gallery?.querySelectorAll<HTMLElement>('.photo-item').forEach(item => {
      item.hidden = button.dataset.filter !== 'all' && !item.dataset.albums?.split(' ').includes(button.dataset.filter || '');
    });
  }));
</script>
