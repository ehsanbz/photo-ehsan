---
import { Image } from 'astro:assets';
interface Props {
  photo: { image: ImageMetadata; alt: string; caption?: string; location?: string; date?: string; camera?: string; lens?: string; textAfter?: string };
  priority?: boolean;
  size?: 'wide' | 'regular';
}
const { photo, priority = false, size = 'regular' } = Astro.props;
const widths = [480, 768, 1100, 1500, 2000].filter((w) => w <= photo.image.width);
const metadata = [photo.location, photo.date, photo.camera, photo.lens].filter(Boolean).join(' · ');
---
<figure class:list={['photo-figure', size]}>
  <Image src={photo.image} alt={photo.alt} widths={widths} sizes={size === 'wide' ? '(max-width: 800px) 100vw, 92vw' : '(max-width: 800px) 100vw, 72vw'} format="webp" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
  {(photo.caption || metadata) && <figcaption><span>{photo.caption}</span>{metadata && <small>{metadata}</small>}</figcaption>}
</figure>
{photo.textAfter && <p class="between-photos">{photo.textAfter}</p>}
