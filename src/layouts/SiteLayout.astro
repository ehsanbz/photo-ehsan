---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, image = '/og-default.png', type = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site).href;
const nav = [['Photography', '/'], ['Stories', '/stories/'], ['Albums', '/albums/'], ['About', '/about/']];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2c3e50" />
    <meta name="author" content="Ehsan Bagherzadeh" />
    <title>{title} · Ehsan Bagherzadeh Photography</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Ehsan Bagherzadeh Photography" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to photographs</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="identity">
          <a class="wordmark" href="/" aria-label="Ehsan Bagherzadeh Photography home">Ehsan Bagherzadeh<span>Photography</span></a>
          <a class="main-site" href="https://www.ehsan.bz/" aria-label="Visit Ehsan's main website (external site)" title="Main website">Main site <span aria-hidden="true">↗</span></a>
        </div>
        <nav aria-label="Primary navigation"><ul>{nav.map(([label, href]) => <li><a href={href} aria-current={path === href || (href !== '/' && path.startsWith(href)) ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Ehsan Bagherzadeh</span>
      <span>Berlin & elsewhere · <a href="https://www.ehsan.bz/">Main website ↗</a></span>
    </footer>
  </body>
</html>
