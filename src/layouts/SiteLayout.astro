---
import { getImage } from 'astro:assets';
import sampleHero from '../assets/sample/berlin-train.webp';
import '../styles/global.css';

interface Props { title: string; description: string; image?: ImageMetadata; type?: 'website' | 'article'; noindex?: boolean; }
const { title, description, image = sampleHero, type = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const social = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const nav = [ ['Stories', '/stories/'], ['Gallery', '/gallery/'], ['Journal', '/journal/'], ['About', '/about/'] ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3f1eb" />
    <meta name="author" content="Ehsan Bagherzadeh" />
    <title>{title} | Ehsan Bagherzadeh Photography</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Ehsan Bagherzadeh Photography" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(social.src, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(social.src, Astro.site).href} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Ehsan Bagherzadeh Photography, home">Ehsan Bagherzadeh<span>Photography</span></a>
      <nav aria-label="Main navigation"><ul>{nav.map(([label, href]) => <li><a href={href} aria-current={Astro.url.pathname === href || (href !== '/gallery/' && Astro.url.pathname.startsWith(href) && Astro.url.pathname !== '/') ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><span class="footer-name">Ehsan Bagherzadeh</span><p>Photographs, places, and passing moments.</p></div>
      <div class="footer-links"><a href="https://www.ehsan.bz">Main site → ehsan.bz</a><span>© {new Date().getFullYear()} Ehsan Bagherzadeh</span></div>
    </footer>
  </body>
</html>
